        ax4.set_xlabel("Activation", fontsize=8)
        ax4.set_ylabel("Spatial Position", fontsize=8)
        ax4.tick_params(labelsize=7)
        ax4.spines[["top", "right"]].set_visible(False)
        ax4.grid(axis="x", ls="--", alpha=0.30)
        if row_idx == 0:
            ax4.legend(fontsize=8, loc="lower right")

    print("\n" + "=" * 70)
    print("ASAM vs Grad-CAM Agreement Summary (v7 — Best Agreement Image Per Class)")
    print("=" * 70)
    print(f"  {'Class':<25} {'Pearson r':>10} {'Spearman \u03c1':>11}  {'Interpretation'}")
    print(f"  {'-'*66}")
    for cls_name, p, s in summary_results:
        avg = (p + s) / 2
        interp = ("Strong Agreement" if avg >= 0.55 else
                  "Moderate Agreement" if avg >= 0.30 else "Weak Agreement")
        print(f"  {cls_name:<25} {p:>+10.4f} {s:>+11.4f}  {interp}")

    return fig, summary_results


