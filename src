CLASS_COLORS = ["#2ecc71", "#3498db", "#e74c3c", "#9b59b6"]


def get_sample_images(test_dir, class_names, preprocess_fn):
    """One preprocessed sample image per class (first test file alphabetically).
    Matches the `sample_images` dict used across the original Grad-CAM /
    Attention scripts.
