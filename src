# "MODEL PARAMETERS OVERALL SUMMARY -- DETAILED VISUALIZATION.txt"
# ---------------------------------------------------------------------
def plot_model_parameters_detailed(best_model):
    total_params = best_model.count_params()
    trainable_params = sum(tf.size(w).numpy() for w in best_model.trainable_weights)
    non_trainable = total_params - trainable_params

    print("=" * 55)
    print(f"  Total Parameters:         {total_params:>15,}")
    print(f"  Trainable Parameters:     {trainable_params:>15,}")
    print(f"  Non-Trainable Parameters: {non_trainable:>15,}")
    print(f"  Model Size (approx):      {total_params * 4 / 1024**2:>14.2f} MB")
    print("=" * 55)

    layer_data = []
    for layer in best_model.layers:
        trainable_p = sum(tf.size(w).numpy() for w in layer.trainable_weights)
        non_train_p = sum(tf.size(w).numpy() for w in layer.non_trainable_weights)
        total_p = trainable_p + non_train_p
        output_shape = str(layer.output_shape) if hasattr(layer, "output_shape") else "N/A"
        layer_data.append({
            "name": layer.name, "type": layer.__class__.__name__, "output_shape": output_shape,
            "trainable": trainable_p, "non_trainable": non_train_p, "total": total_p,
        })

    df = pd.DataFrame(layer_data)
    df = df[df["total"] > 0]
    print(f"\nLayers with parameters: {len(df)} / {len(best_model.layers)}")
    print(df.to_string(index=False))

    figs = []

    # Fig 1: top-15 bar chart + layer-type pie chart
    df_sorted = df.sort_values("total", ascending=False).head(15)
    fig1, axes = plt.subplots(1, 2, figsize=(16, 6))
    fig1.suptitle("Model Parameter Distribution", fontsize=15, fontweight="bold")

    colors = plt.cm.RdYlGn(np.linspace(0.2, 0.9, len(df_sorted)))[::-1]
    bars = axes[0].barh(df_sorted["name"], df_sorted["total"], color=colors, edgecolor="white", linewidth=0.5)
    axes[0].set_xlabel("Parameter Count", fontsize=11)
    axes[0].set_title("Top 15 Layers by Parameter Count", fontsize=12, fontweight="bold")
    axes[0].invert_yaxis()
    axes[0].spines[["top", "right"]].set_visible(False)
    axes[0].grid(axis="x", linestyle="--", alpha=0.4)
    for bar, val in zip(bars, df_sorted["total"]):
        axes[0].text(bar.get_width() + total_params * 0.001, bar.get_y() + bar.get_height() / 2,
                     f"{val:,}", va="center", fontsize=8, fontweight="bold")

    type_counts = df.groupby("type")["total"].sum().sort_values(ascending=False)
    pie_colors = plt.cm.Set3(np.linspace(0, 1, len(type_counts)))
    wedges, texts, autotexts = axes[1].pie(
        type_counts.values, labels=type_counts.index, autopct="%1.1f%%",
