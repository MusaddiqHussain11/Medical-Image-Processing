# "T-SNE FEATURE EMBEDDING.txt"
# ---------------------------------------------------------------------
def plot_tsne(best_model, X_test, y_test, class_names, seed: int = 42):
    gap_layer = [l.name for l in best_model.layers
                 if isinstance(l, tf.keras.layers.GlobalAveragePooling2D)][0]
    feat_extractor = models.Model(inputs=best_model.input, outputs=best_model.get_layer(gap_layer).output)

    print("Extracting CNN features for t-SNE...")
    features = feat_extractor.predict(X_test, verbose=1)

    print("Applying t-SNE (this may take a minute)...")
    tsne = TSNE(n_components=2, random_state=seed, perplexity=min(30, len(X_test) - 1))
    tsne_feats = tsne.fit_transform(features)

    fig, ax = plt.subplots(figsize=(11, 8))
    tsne_colors = ["#3498db", "#2ecc71", "#e74c3c", "#9b59b6"]
    for ci, cname in enumerate(class_names):
        mask = y_test == ci
        ax.scatter(tsne_feats[mask, 0], tsne_feats[mask, 1], c=tsne_colors[ci % len(tsne_colors)],
                   label=cname, alpha=0.75, edgecolors="white", linewidths=0.5, s=60)

    ax.set_title("t-SNE Feature Embedding — CNN Extracted Features", fontsize=15, fontweight="bold")
    ax.set_xlabel("t-SNE Dimension 1", fontsize=12)
    ax.set_ylabel("t-SNE Dimension 2", fontsize=12)
    ax.legend(fontsize=11, markerscale=1.4)
    ax.spines[["top", "right"]].set_visible(False)
    ax.grid(linestyle="--", alpha=0.3)
    plt.tight_layout()
    return fig

"""
ASAM-CNN architecture: a lightweight CNN backbone integrated with the
multi-component Adaptive Self-Attention Module (ASAM), consisting of:

  1. AdaptiveScaleLayer      -- per-image, per-channel input scaling
                                  learned from GAP + GMP + std feature statistics.
  2. DynamicTemperatureLayer -- per-image softmax temperature for the
                                  self-attention map (controls sharpness).
  3. Dual-Path Local-Global Blending -- combines a global self-attention
                                  path with a local depthwise-conv path,
                                  blended via a learned per-channel alpha.

These make the attention truly input-dependent, unlike fixed/generic
attention modules that apply the same pattern to every image.
"""

import tensorflow as tf
from tensorflow.keras import layers, models, regularizers


class AdaptiveScaleLayer(layers.Layer):
    """Input-dependent adaptive channel scaling.

    Computes a per-image, per-channel scale factor from the input's own
    feature statistics (global average + global max + std), rather than
    using a fixed learned gamma.
    """

    def build(self, input_shape):
        c = input_shape[-1]
        self.dense1 = layers.Dense(max(c // 8, 1), activation="relu")
        self.dense2 = layers.Dense(c, activation="sigmoid")
        self.gap = layers.GlobalAveragePooling2D()
        self.gmp = layers.GlobalMaxPooling2D()

    def call(self, x):
        avg = self.gap(x)                                    # (B, C)
        mx = self.gmp(x)                                      # (B, C)
        std = tf.math.reduce_std(
            tf.reshape(x, [tf.shape(x)[0], -1, x.shape[-1]]), axis=1
        )                                                      # (B, C)
        stats = avg + mx + std
        scale = self.dense2(self.dense1(stats))
        scale = tf.reshape(scale, [-1, 1, 1, x.shape[-1]])
        return x * scale


class DynamicTemperatureLayer(layers.Layer):
    """Per-image dynamic softmax temperature for self-attention.

    Low temperature -> sharper/more focused attention.
    High temperature -> softer/more uniform attention.
    The model learns when to focus vs. distribute attention, per image.
    """

    def build(self, input_shape):
        c = input_shape[-1]
        self.gap = layers.GlobalAveragePooling2D()
        self.dense1 = layers.Dense(max(c // 16, 1), activation="relu")
        self.dense2 = layers.Dense(1, activation="softplus")  # always > 0

    def call(self, x):
        t = self.gap(x)
        t = self.dense2(self.dense1(t))                       # (B, 1)
        t = tf.clip_by_value(t, 0.1, 10.0)
        t = tf.reshape(t, [-1, 1, 1])
        return t


CUSTOM_OBJECTS = {
    "AdaptiveScaleLayer": AdaptiveScaleLayer,
    "DynamicTemperatureLayer": DynamicTemperatureLayer,
}


def channel_attention(x):
    """CBAM-style channel attention (unchanged from standard formulation)."""
    channels = x.shape[-1]
    avg = layers.GlobalAveragePooling2D()(x)
    maxp = layers.GlobalMaxPooling2D()(x)
    dense1 = layers.Dense(channels // 16, activation="relu")
    dense2 = layers.Dense(channels, activation="sigmoid")
    avg = dense2(dense1(avg))
    maxp = dense2(dense1(maxp))
    scale = layers.Add()([avg, maxp])
    scale = layers.Reshape((1, 1, channels))(scale)
    return layers.Multiply()([x, scale])


def adaptive_self_attention(x, l2_weight: float = 1e-4):
    """The ASAM module: adaptive scaling + dynamic-temperature self-attention
    + dual-path (global attention / local depthwise conv) blending.
    """
    channels = x.shape[-1]
    h = x.shape[1]
    w = x.shape[2]
    hw = h * w
    d_k = max(channels // 32, 1)

    # STEP 1: Adaptive Input Scaling
    x_scaled = AdaptiveScaleLayer()(x)

    # STEP 2: Q, K, V Projections
    q = layers.Conv2D(d_k, 1, padding="same",
                       kernel_regularizer=regularizers.l2(l2_weight))(x_scaled)
    k = layers.Conv2D(d_k, 1, padding="same",
                       kernel_regularizer=regularizers.l2(l2_weight))(x_scaled)
    v = layers.Conv2D(channels, 1, padding="same",
                       kernel_regularizer=regularizers.l2(l2_weight))(x_scaled)

    q_flat = layers.Reshape((hw, d_k))(q)
    k_flat = layers.Reshape((hw, d_k))(k)
    v_flat = layers.Reshape((hw, channels))(v)

    # STEP 3: Dynamic Temperature Scaling
    temp = DynamicTemperatureLayer()(x_scaled)                # (B, 1, 1)

    scale_factor = tf.cast(tf.math.sqrt(float(d_k)), tf.float32)
    attn_logits = layers.Dot(axes=[2, 2])([q_flat, k_flat])   # (B, HW, HW)
    attn_logits = attn_logits / (temp * scale_factor)

    attn_map = layers.Softmax()(attn_logits)

    out = layers.Dot(axes=[2, 1])([attn_map, v_flat])
    out = layers.Reshape((h, w, channels))(out)
    out = layers.Conv2D(channels, 1, padding="same",
                         kernel_regularizer=regularizers.l2(l2_weight))(out)

    # STEP 4: Dual-Path -- Local + Global
    local = layers.DepthwiseConv2D(
        3, padding="same",
        depthwise_regularizer=regularizers.l2(l2_weight)
    )(x_scaled)
    local = layers.BatchNormalization()(local)
    local = layers.ReLU()(local)

    alpha_in = layers.GlobalAveragePooling2D()(x_scaled)
    alpha = layers.Dense(channels, activation="sigmoid")(alpha_in)
    alpha = layers.Reshape((1, 1, channels))(alpha)

    blended = (alpha * out) + ((1.0 - alpha) * local)

    # STEP 5: Residual Connection
    return layers.Add()([x, blended])


def build_model(img_size: int = 224, num_classes: int = 4, l2_weight: float = 1e-4):
    """Build and compile the ASAM-CNN model."""
    inputs = layers.Input(shape=(img_size, img_size, 3))
    x = layers.RandomFlip("horizontal")(inputs)
    x = layers.RandomFlip("vertical")(x)
    x = layers.RandomRotation(0.01)(x)
    x = layers.RandomZoom(0.01)(x)
    x = layers.RandomContrast(0.01)(x)

    for filters in (32, 64, 128, 256):
        x = layers.Conv2D(filters, 3, padding="same",
                           kernel_regularizer=regularizers.l2(l2_weight))(x)
        x = layers.BatchNormalization()(x)
        x = layers.ReLU()(x)
        x = layers.MaxPooling2D()(x)

    x = adaptive_self_attention(x, l2_weight=l2_weight)
    x = channel_attention(x)

    # Residual block
    shortcut = x
    x = layers.Conv2D(256, 3, padding="same",
                       kernel_regularizer=regularizers.l2(l2_weight))(x)
    x = layers.BatchNormalization()(x)
    x = layers.ReLU()(x)
    x = layers.Conv2D(256, 3, padding="same",
                       kernel_regularizer=regularizers.l2(l2_weight))(x)
    x = layers.BatchNormalization()(x)
    x = layers.ReLU()(x)
    x = layers.Conv2D(256, 3, padding="same",
                       kernel_regularizer=regularizers.l2(l2_weight))(x)
    x = layers.BatchNormalization()(x)
    shortcut = layers.Conv2D(256, 1, padding="same",
                              kernel_regularizer=regularizers.l2(l2_weight))(shortcut)
    shortcut = layers.BatchNormalization()(shortcut)
    x = layers.Add()([x, shortcut])
    x = layers.ReLU()(x)

    x = layers.GlobalAveragePooling2D()(x)
    x = layers.Dense(128, activation="relu")(x)
    x = layers.Dropout(0.8)(x)
    outputs = layers.Dense(num_classes, activation="softmax")(x)

    model = models.Model(inputs, outputs)
    model.compile(
        optimizer=tf.keras.optimizers.Adam(1e-4),
        loss="categorical_crossentropy",
        metrics=["accuracy"],
    )
    return model
"""
Domain-specific preprocessing pipeline for otoscopic images:
circular cropping (isolates the circular otoscope field of view)
+ CLAHE contrast enhancement on the L channel (LAB color space).
"""

import cv2
import numpy as np


def circular_crop(img: np.ndarray) -> np.ndarray:
    """Mask everything outside the circular otoscope field of view."""
    h, w = img.shape[:2]
    center = (w // 2, h // 2)
    radius = min(center)
    mask = np.zeros((h, w), np.uint8)
    cv2.circle(mask, center, radius, 255, -1)
    return cv2.bitwise_and(img, img, mask=mask)


def apply_clahe_rgb(img: np.ndarray) -> np.ndarray:
    """Apply CLAHE to the L channel in LAB space, then convert back to RGB."""
    lab = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)
    l, a, b = cv2.split(lab)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    l = clahe.apply(l)
    lab = cv2.merge((l, a, b))
    return cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)


def preprocess(path: str, img_size: int = 224) -> np.ndarray:
    """Load an image from disk and apply the full preprocessing pipeline.

    Steps: BGR->RGB -> circular crop -> resize -> CLAHE -> scale to [0, 1].
    """
    img = cv2.imread(path)
    if img is None:
        raise ValueError(f"Cannot read image: {path}")
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    img = circular_crop(img)
    img = cv2.resize(img, (img_size, img_size))
    img = apply_clahe_rgb(img)
    return (img / 255.0).astype(np.float32)
"""
Loads the training data, runs 5-fold stratified cross-validation,
and saves the best checkpoint per fold.

Usage:
    python -m src.train --config configs/config.yaml
"""

import argparse
import os

import numpy as np
import tensorflow as tf
import yaml
from sklearn.metrics import f1_score
from sklearn.model_selection import StratifiedKFold
from tensorflow.keras.utils import to_categorical

from .model import build_model
from .preprocess import preprocess
from .utils import set_seed, configure_gpu, find_dataset_root


def get_callbacks(ckpt_path: str):
    return [
        tf.keras.callbacks.ModelCheckpoint(
            filepath=ckpt_path, monitor="val_loss", save_best_only=True, verbose=0
        ),
        tf.keras.callbacks.ReduceLROnPlateau(
            monitor="val_loss", factor=0.5, patience=5, min_lr=1e-6, verbose=1
        ),
        tf.keras.callbacks.EarlyStopping(
            monitor="val_loss", patience=15, restore_best_weights=True, verbose=1
        ),
    ]


def load_class_folder(base_dir: str, class_names, img_size: int):
    X, y = [], []
    class_to_index = {name: i for i, name in enumerate(class_names)}
    for cname in class_names:
        folder = os.path.join(base_dir, cname)
        for fname in sorted(os.listdir(folder)):
            X.append(preprocess(os.path.join(folder, fname), img_size=img_size))
            y.append(class_to_index[cname])
    return np.array(X, dtype=np.float32), np.array(y)


def run_cross_validation(cfg: dict):
    set_seed(cfg["seed"])
    configure_gpu()

    dataset_root = find_dataset_root(cfg["paths"]["input_root"])
    train_dir = os.path.join(dataset_root, "Training-validation")

    class_names = sorted(
        d for d in os.listdir(train_dir) if os.path.isdir(os.path.join(train_dir, d))
    )
    num_classes = len(class_names)
    print("Classes:", class_names)

    img_size = cfg["img_size"]
    X, y = load_class_folder(train_dir, class_names, img_size)
    print("Total training images:", len(X))
    for i, c in enumerate(class_names):
        print(f"  {c}: {np.sum(y == i)}")

    y_cat = to_categorical(y)
    ckpt_dir = cfg["paths"]["checkpoint_dir"]
    os.makedirs(ckpt_dir, exist_ok=True)

    skf = StratifiedKFold(n_splits=cfg["n_folds"], shuffle=True, random_state=cfg["seed"])

    cv_acc, cv_f1, cv_history, fold_ckpts = [], [], [], []
    best_fold_f1, best_ckpt = 0.0, None

    for fold, (train_idx, val_idx) in enumerate(skf.split(X, y), 1):
        print(f"\n===== Fold {fold} / {cfg['n_folds']} =====")
        print(f"  Train: {len(train_idx)}  Val: {len(val_idx)}")

        model = build_model(img_size=img_size, num_classes=num_classes, l2_weight=cfg["l2_weight"])
        ckpt_path = os.path.join(ckpt_dir, f"fold_{fold}.keras")

        history = model.fit(
            X[train_idx], y_cat[train_idx],
            validation_data=(X[val_idx], y_cat[val_idx]),
            epochs=cfg["epochs"],
            batch_size=cfg["batch_size"],
            callbacks=get_callbacks(ckpt_path),
            verbose=1,
        )
        cv_history.append(history.history)

        from .model import CUSTOM_OBJECTS
        model = tf.keras.models.load_model(ckpt_path, custom_objects=CUSTOM_OBJECTS)
        preds = model.predict(X[val_idx], verbose=0)
        classes = np.argmax(preds, axis=1)

        acc = np.mean(classes == y[val_idx])
        f1 = f1_score(y[val_idx], classes, average="macro")
        print(f"  Fold {fold} Accuracy: {acc:.4f}  F1: {f1:.4f}")

        cv_acc.append(acc)
        cv_f1.append(f1)
        fold_ckpts.append(ckpt_path)
        if f1 > best_fold_f1:
            best_fold_f1, best_ckpt = f1, ckpt_path

    print(f"\nMean Accuracy : {np.mean(cv_acc):.4f} +/- {np.std(cv_acc):.4f}")
    print(f"Mean F1       : {np.mean(cv_f1):.4f} +/- {np.std(cv_f1):.4f}")

    return {
        "class_names": class_names,
        "cv_acc": cv_acc,
        "cv_f1": cv_f1,
        "cv_history": cv_history,
        "fold_ckpts": fold_ckpts,
        "best_ckpt": best_ckpt,
    }


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="configs/config.yaml")
    args = parser.parse_args()

    with open(args.config) as f:
        cfg = yaml.safe_load(f)

    run_cross_validation(cfg)
"""Shared utilities: reproducibility seeding, dataset auto-discovery,
figure auto-save on plt.show(), and zipping figures for download.
"""

import os
import random
import zipfile

import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt


def set_seed(seed: int = 42):
    """Fix all relevant RNG seeds for reproducibility."""
    os.environ["PYTHONHASHSEED"] = str(seed)
    np.random.seed(seed)
    random.seed(seed)
    tf.random.set_seed(seed)


def configure_gpu():
    """Enable memory growth on any available GPU (avoids TF grabbing all VRAM)."""
    gpus = tf.config.experimental.list_physical_devices("GPU")
    for gpu in gpus:
        tf.config.experimental.set_memory_growth(gpu, True)


def find_dataset_root(input_root: str = "/kaggle/input") -> str:
    """Auto-detect the dataset folder containing 'Training-validation' and
    'Testing' subfolders (searches recursively under input_root).
    """
    for dataset in os.listdir(input_root):
        dataset_path = os.path.join(input_root, dataset)
        for root, dirs, _ in os.walk(dataset_path):
            if "Training-validation" in dirs and "Testing" in dirs:
                return root
    raise RuntimeError(
        "Dataset not found. Expected 'Training-validation' and 'Testing' folders "
        f"somewhere under {input_root}."
    )


def enable_figure_autosave(save_dir: str = "/kaggle/working/figures"):
    """Monkey-patch plt.show() to also save each figure as a numbered PNG."""
    os.makedirs(save_dir, exist_ok=True)
    counter = {"count": 0}
    original_show = plt.show

    def auto_save_show(*args, **kwargs):
        counter["count"] += 1
        path = os.path.join(save_dir, f"figure_{counter['count']:02d}.png")
        plt.savefig(path, dpi=300, bbox_inches="tight")
        print(f"Saved: {path}")
        original_show(*args, **kwargs)

    plt.show = auto_save_show


def zip_figures(figures_dir: str, zip_path: str):
    """Zip every PNG found under figures_dir into a single archive."""
    png_files = []
    for root, _, files in os.walk(figures_dir):
        for f in files:
            if f.endswith(".png"):
                png_files.append(os.path.join(root, f))

    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zipf:
        for fpath in png_files:
            zipf.write(fpath, arcname=os.path.basename(fpath))
            print(f"  Added: {os.path.basename(fpath)}")

    size_mb = os.path.getsize(zip_path) / 1024 / 1024
    print(f"\nZIP ready: {zip_path} ({size_mb:.2f} MB, {len(png_files)} figures)")
    return zip_path
