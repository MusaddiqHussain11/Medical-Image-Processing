# ---------------------------------------------------------------------
# "ROC CURVES (MULTI-CLASS).txt"
# ---------------------------------------------------------------------
def plot_roc_curves(y_test, y_pred_proba, class_names):
    num_classes = len(class_names)
    y_test_bin = label_binarize(y_test, classes=list(range(num_classes)))
    roc_colors = ["#3498db", "#2ecc71", "#e74c3c", "#9b59b6"]

    fig, ax = plt.subplots(figsize=(10, 8))
    for i, cname in enumerate(class_names):
        fpr, tpr, _ = roc_curve(y_test_bin[:, i], y_pred_proba[:, i])
        roc_auc = auc(fpr, tpr)
        ax.plot(fpr, tpr, color=roc_colors[i % len(roc_colors)], linewidth=2.5,
                label=f"{cname} (AUC = {roc_auc:.4f})")

    all_fpr = np.unique(np.concatenate(
        [roc_curve(y_test_bin[:, i], y_pred_proba[:, i])[0] for i in range(num_classes)]))
    mean_tpr = np.zeros_like(all_fpr)
    for i in range(num_classes):
        fpr, tpr, _ = roc_curve(y_test_bin[:, i], y_pred_proba[:, i])
        mean_tpr += np.interp(all_fpr, fpr, tpr)
    mean_tpr /= num_classes
    macro_auc = auc(all_fpr, mean_tpr)
    ax.plot(all_fpr, mean_tpr, color="#2c3e50", linewidth=3, linestyle="--",
            label=f"Macro Average (AUC = {macro_auc:.4f})")

    ax.plot([0, 1], [0, 1], color="gray", linewidth=1.5, linestyle=":")
    ax.set_xlim([0.0, 1.0])
    ax.set_ylim([0.0, 1.05])
    ax.set_xlabel("False Positive Rate", fontsize=13)
    ax.set_ylabel("True Positive Rate", fontsize=13)
    ax.set_title("ROC Curves (Multi-Class)", fontsize=15, fontweight="bold")
    ax.legend(loc="lower right", fontsize=11)
    ax.spines[["top", "right"]].set_visible(False)
    ax.grid(linestyle="--", alpha=0.4)
    plt.tight_layout()
    return fig


