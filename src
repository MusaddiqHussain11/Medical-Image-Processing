import os

import cv2
import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt

from .model import AdaptiveScaleLayer, DynamicTemperatureLayer

CLASS_COLORS = ["#2ecc71", "#3498db", "#e74c3c", "#9b59b6"]


def setup_asam_internals(best_model, sample_images, viz_dir: str = "/kaggle/working/viz_asam_internals"):
    """Reconstructed setup cell -- see module docstring."""
    os.makedirs(viz_dir, exist_ok=True)

    model = best_model  # alias, matches how the original scripts refer to it
    class_images = sample_images  # same one-per-class dict used elsewhere

    adaptive_scale_layers = [l.name for l in model.layers if isinstance(l, AdaptiveScaleLayer)]
    dynamic_temp_layers = [l.name for l in model.layers if isinstance(l, DynamicTemperatureLayer)]
    dense_sigmoid_layers = [
        l.name for l in model.layers
        if isinstance(l, layers.Dense) and l.activation == tf.keras.activations.sigmoid
    ]
    add_layers = [l.name for l in model.layers if isinstance(l, layers.Add)]
    depthwise_layers = [l.name for l in model.layers if isinstance(l, layers.DepthwiseConv2D)]

    return {
        "model": model,
        "class_images": class_images,
        "VIZ_DIR": viz_dir,
        "adaptive_scale_layers": adaptive_scale_layers,
        "dynamic_temp_layers": dynamic_temp_layers,
        "dense_sigmoid_layers": dense_sigmoid_layers,
        "add_layers": add_layers,
        "depthwise_layers": depthwise_layers,
    }


# ---------------------------------------------------------------------
# "ADAPTIVE SCALE LAYER -- Heatmap per class.txt"
# ---------------------------------------------------------------------
def plot_adaptive_scale_heatmap(ctx, class_names, num_classes: int):
    model, class_images, viz_dir = ctx["model"], ctx["class_images"], ctx["VIZ_DIR"]
    adaptive_scale_layers = ctx["adaptive_scale_layers"]

    if not adaptive_scale_layers:
        print("  AdaptiveScaleLayer nahi mili — skip.")
        return None, None

    scale_extractor = models.Model(inputs=model.input,
                                    outputs=model.get_layer(adaptive_scale_layers[0]).output)

    fig, axes = plt.subplots(2, num_classes, figsize=(5 * num_classes, 10))
    fig.suptitle("Adaptive Scale Layer — Channel-wise Scale Factors per Class",
                 fontsize=15, fontweight="bold", y=1.01)

    scale_vals_all = []
    for ci, cname in enumerate(class_names):
        img_batch = class_images[cname][np.newaxis, ...]
        scaled_fm = scale_extractor.predict(img_batch, verbose=0)

        scale_per_channel = np.mean(scaled_fm[0], axis=(0, 1))
        scale_vals_all.append(scale_per_channel)
        orig_mean = np.mean(scaled_fm[0], axis=-1)

        ax1 = axes[0, ci]
        im1 = ax1.imshow(orig_mean, cmap="hot", interpolation="bilinear")
        ax1.set_title(f"{cname}\nFeature Map (post-scale)", fontsize=11, fontweight="bold")
        ax1.axis("off")
        plt.colorbar(im1, ax=ax1, fraction=0.046, pad=0.04)

        ax2 = axes[1, ci]
        top_n = min(32, len(scale_per_channel))
        ch_idx = np.argsort(scale_per_channel)[::-1][:top_n]
        ax2.bar(range(top_n), scale_per_channel[ch_idx],
                color=CLASS_COLORS[ci % len(CLASS_COLORS)], alpha=0.85, edgecolor="white")
        ax2.set_title(f"Top-{top_n} Channel Scales", fontsize=10)
        ax2.set_xlabel("Channel Index (sorted)", fontsize=9)
        ax2.set_ylabel("Scale Value", fontsize=9)
        ax2.grid(axis="y", alpha=0.3)
        ax2.spines[["top", "right"]].set_visible(False)

    plt.tight_layout()
    save_path = os.path.join(viz_dir, "viz1_adaptive_scale_heatmap.png")
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    print(f"Saved: {save_path}")

    fig2, ax = plt.subplots(figsize=(10, 5))
    means = [np.mean(s) for s in scale_vals_all]
    stds = [np.std(s) for s in scale_vals_all]
    bars = ax.bar(class_names, means, color=CLASS_COLORS[:num_classes], yerr=stds, capsize=5,
                   alpha=0.85, edgecolor="white")
    for bar, val in zip(bars, means):
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.002,
                f"{val:.3f}", ha="center", va="bottom", fontsize=10, fontweight="bold")
    ax.set_title("Mean Adaptive Scale Factor per Class", fontsize=13, fontweight="bold")
    ax.set_ylabel("Mean Scale Factor")
    ax.set_xlabel("Class")
    ax.grid(axis="y", alpha=0.3)
    ax.spines[["top", "right"]].set_visible(False)
    plt.tight_layout()
    save_path2 = os.path.join(viz_dir, "viz1b_scale_summary.png")
    plt.savefig(save_path2, dpi=150, bbox_inches="tight")
    print(f"Saved: {save_path2}")

    return fig, fig2


