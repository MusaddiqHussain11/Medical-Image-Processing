def make_gradcam_heatmap(img_array, model, last_conv_layer_name):
    grad_model = tf.keras.models.Model(
        model.inputs, [model.get_layer(last_conv_layer_name).output, model.output]
    )
    with tf.GradientTape() as tape:
        conv_outputs, predictions = grad_model(img_array)
        pred_index = tf.argmax(predictions[0])
        class_channel = predictions[:, pred_index]
    grads = tape.gradient(class_channel, conv_outputs)
    pooled = tf.reduce_mean(grads, axis=(0, 1, 2))
    conv_out = conv_outputs[0]
    heatmap = conv_out @ pooled[..., tf.newaxis]
    heatmap = tf.squeeze(heatmap)
    heatmap = tf.maximum(heatmap, 0) / (tf.math.reduce_max(heatmap) + 1e-8)
    return heatmap.numpy()


def plot_gradcam_lesion_localization(best_model, sample_images, class_names, conv_layers,
                                      img_size: int = 224):
    last_conv = conv_layers[-1]

    fig, axes = plt.subplots(len(class_names), 3, figsize=(12, len(class_names) * 3.5))
    fig.suptitle("Grad-CAM Lesion Localization", fontsize=16, fontweight="bold")

    for ci, cname in enumerate(class_names):
        img = sample_images[cname]
        inp = np.expand_dims(img, 0)
        hmap = make_gradcam_heatmap(inp, best_model, last_conv)
        hmap = cv2.resize(hmap, (img_size, img_size))
        hmap = np.uint8(255 * hmap)
        hmap_color = cv2.applyColorMap(hmap, cv2.COLORMAP_JET)
        hmap_color = cv2.cvtColor(hmap_color, cv2.COLOR_BGR2RGB)
        overlay = img * 0.55 + hmap_color / 255.0 * 0.45
        overlay = np.clip(overlay, 0, 1)

        axes[ci][0].imshow(img)
        axes[ci][0].set_title("Original" if ci == 0 else "")
        axes[ci][1].imshow(hmap_color)
        axes[ci][1].set_title("Grad-CAM Heatmap" if ci == 0 else "")
        axes[ci][2].imshow(overlay)
        axes[ci][2].set_title("Overlay" if ci == 0 else "")
        axes[ci][0].set_ylabel(cname, fontsize=11, fontweight="bold",
                                color=CLASS_COLORS[ci % len(CLASS_COLORS)])
        for ax in axes[ci]:
            ax.axis("off")

    plt.tight_layout()
    return fig


