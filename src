# ---------------------------------------------------------------------
# "5-FOLD CROSS VALIDATION ACCURACY.txt" / "...F1 SCORE.txt"
# ---------------------------------------------------------------------
def plot_cv_bar(values, metric_name: str, n_folds: int):
    folds = list(range(1, n_folds + 1))
    fig, ax = plt.subplots(figsize=(10, 5))
    bars = ax.bar(folds, values, color=FOLD_COLORS[:n_folds], edgecolor="white", linewidth=1.5, zorder=3)
    mean_v, std_v = np.mean(values), np.std(values)
    ax.axhline(mean_v, color="#2c3e50", linestyle="--", linewidth=2, label=f"Mean = {mean_v:.4f}", zorder=4)
    ax.fill_between([0.5, n_folds + 0.5], mean_v - std_v, mean_v + std_v, alpha=0.12, color="#2c3e50", zorder=2)
    for bar, val in zip(bars, values):
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.002,
                f"{val:.4f}", ha="center", va="bottom", fontsize=11, fontweight="bold")
    ax.set_xlabel("Fold", fontsize=13)
    ax.set_ylabel(metric_name, fontsize=13)
    ax.set_title(f"5-Fold Cross Validation {metric_name}", fontsize=15, fontweight="bold")
    ax.set_xticks(folds)
    ax.set_xticklabels([f"Fold {f}" for f in folds], fontsize=11)
    ax.set_ylim(max(0, min(values) - 0.05), 1.02)
    ax.legend(fontsize=11)
    ax.spines[["top", "right"]].set_visible(False)
    ax.grid(axis="y", linestyle="--", alpha=0.4, zorder=1)
    plt.tight_layout()
    return fig


# ---------------------------------------------------------------------
# "LEARNING CURVES (per fold).txt"
# ---------------------------------------------------------------------
def plot_learning_curves(cv_history, n_folds: int):
    fig, axes = plt.subplots(n_folds, 2, figsize=(14, n_folds * 3.5))
    fig.suptitle("Learning Curves (Per Fold)", fontsize=16, fontweight="bold")

    for fi, hist in enumerate(cv_history):
        ep = range(1, len(hist["loss"]) + 1)

        ax_loss = axes[fi][0]
        ax_loss.plot(ep, hist["loss"], color="#3498db", linewidth=2, label="Train Loss")
        ax_loss.plot(ep, hist["val_loss"], color="#e74c3c", linewidth=2, linestyle="--", label="Val Loss")
        ax_loss.set_title(f"Fold {fi+1} — Loss", fontsize=11, fontweight="bold")
        ax_loss.set_xlabel("Epoch")
        ax_loss.set_ylabel("Loss")
        ax_loss.legend(fontsize=9)
        ax_loss.spines[["top", "right"]].set_visible(False)
        ax_loss.grid(linestyle="--", alpha=0.4)

        ax_acc = axes[fi][1]
        ax_acc.plot(ep, hist["accuracy"], color="#2ecc71", linewidth=2, label="Train Acc")
        ax_acc.plot(ep, hist["val_accuracy"], color="#9b59b6", linewidth=2, linestyle="--", label="Val Acc")
        ax_acc.set_title(f"Fold {fi+1} — Accuracy", fontsize=11, fontweight="bold")
        ax_acc.set_xlabel("Epoch")
        ax_acc.set_ylabel("Accuracy")
        ax_acc.legend(fontsize=9)
        ax_acc.spines[["top", "right"]].set_visible(False)
        ax_acc.grid(linestyle="--", alpha=0.4)

    plt.tight_layout()
    return fig


