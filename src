def plot_dynamic_temperature_value(ctx, class_names, num_classes: int):
    model, class_images, viz_dir = ctx["model"], ctx["class_images"], ctx["VIZ_DIR"]
    dynamic_temp_layers = ctx["dynamic_temp_layers"]

    if not dynamic_temp_layers:
        print("  DynamicTemperatureLayer nahi mili — skip.")
        return None

    temp_extractor = models.Model(inputs=model.input, outputs=model.get_layer(dynamic_temp_layers[0]).output)

    temp_values = []
    for cname in class_names:
        img_batch = class_images[cname][np.newaxis, ...]
        temp = temp_extractor.predict(img_batch, verbose=0)
        temp_values.append(float(temp.squeeze()))

    print("  Temperature values per class:")
    for cname, tv in zip(class_names, temp_values):
        print(f"    {cname}: {tv:.4f}")

    fig, ax = plt.subplots(figsize=(11, 7))
    bars = ax.bar(class_names, temp_values, color=CLASS_COLORS[:num_classes], alpha=0.85, edgecolor="white")
    for bar, val in zip(bars, temp_values):
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.005,
                f"{val:.3f}", ha="center", va="bottom", fontsize=11, fontweight="bold")

    ax.axhline(y=1.0, color="gray", linestyle="--", lw=1.5, label="T=1 (neutral)")
    ax.set_title("Dynamic Temperature Layer — Value per Class", fontsize=14, fontweight="bold", pad=15)
    ax.set_xlabel("Class (Low T = Sharp Attention  |  High T = Soft Attention)", fontsize=11)
    ax.set_ylabel("Temperature Value", fontsize=11)
    ax.set_ylim([0, max(temp_values) * 1.45])
    ax.legend(fontsize=10)
    ax.grid(axis="y", alpha=0.3)
    ax.spines[["top", "right"]].set_visible(False)

    min_idx = int(np.argmin(temp_values))
    max_idx = int(np.argmax(temp_values))
    y_offset = max(temp_values) * 0.55

    ax.annotate("Sharpest\nAttention", xy=(min_idx, temp_values[min_idx]),
                xytext=(min_idx, temp_values[min_idx] + y_offset), ha="center",
                arrowprops=dict(arrowstyle="->", color="red", lw=1.5), color="red", fontsize=10, fontweight="bold")
    ax.annotate("Softest\nAttention", xy=(max_idx, temp_values[max_idx]),
                xytext=(max_idx, temp_values[max_idx] + y_offset * 0.85), ha="center",
                arrowprops=dict(arrowstyle="->", color="#2980b9", lw=1.5), color="#2980b9", fontsize=10, fontweight="bold")

    plt.tight_layout()
    save_path = os.path.join(viz_dir, "viz2_dynamic_temperature.png")
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    print(f"Saved: {save_path}")
    return fig


