def plot_asam_output_attention_map(ctx, class_names, num_classes: int, img_size: int = 224):
    model, class_images, viz_dir = ctx["model"], ctx["class_images"], ctx["VIZ_DIR"]
    add_layers = ctx["add_layers"]

    if not add_layers:
        print("  Add layers nahi mili — skip.")
        return None, None

    asam_add_name = None
    for lname in add_layers:
        try:
            out_shape = model.get_layer(lname).output.shape
            if len(out_shape) == 4 and out_shape[-1] == 256:
                asam_add_name = lname
                break
        except Exception:
            continue

    if not asam_add_name:
        print("  ASAM Add layer (256ch) nahi mila — skip.")
        return None, None

    print(f"  ASAM output layer: {asam_add_name}")
    asam_extractor = models.Model(inputs=model.input, outputs=model.get_layer(asam_add_name).output)

    fig, axes = plt.subplots(2, num_classes, figsize=(5 * num_classes, 10))
    fig.suptitle("ASAM Output — Attention Map per Class", fontsize=15, fontweight="bold", y=1.01)

    for ci, cname in enumerate(class_names):
        img_batch = class_images[cname][np.newaxis, ...]
        feat_map = asam_extractor.predict(img_batch, verbose=0)[0]

        attn_map = np.mean(feat_map, axis=-1)
        attn_min, attn_max = attn_map.min(), attn_map.max()
        attn_norm = (attn_map - attn_min) / (attn_max - attn_min) if attn_max > attn_min else attn_map
        attn_resized = cv2.resize(attn_norm, (img_size, img_size))

        ax1 = axes[0, ci]
        orig_img = class_images[cname]
        ax1.imshow(orig_img)
        ax1.imshow(attn_resized, cmap="jet", alpha=0.45)
        ax1.set_title(f"{cname}\nAttention Overlay", fontsize=11, fontweight="bold")
        ax1.axis("off")

        ax2 = axes[1, ci]
        im2 = ax2.imshow(attn_resized, cmap="hot", interpolation="bilinear")
        ax2.set_title("Pure Attention Map", fontsize=10)
        ax2.axis("off")
        plt.colorbar(im2, ax=ax2, fraction=0.046, pad=0.04)

    plt.tight_layout()
    save_path = os.path.join(viz_dir, "viz4_asam_attention_map.png")
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    print(f"Saved: {save_path}")
    return fig, asam_add_name


