def plot_dual_path_alpha_blending(ctx, class_names, num_classes: int):
    model, class_images, viz_dir = ctx["model"], ctx["class_images"], ctx["VIZ_DIR"]
    dense_sigmoid_layers = ctx["dense_sigmoid_layers"]

    if not dense_sigmoid_layers:
        print("  Alpha Dense layer nahi mila — skip.")
        return None

    alpha_layer_name = dense_sigmoid_layers[0]
    alpha_extractor = models.Model(inputs=model.input, outputs=model.get_layer(alpha_layer_name).output)

    alpha_per_class, alpha_means, alpha_stds = {}, [], []
    for cname in class_names:
        img_batch = class_images[cname][np.newaxis, ...]
        alpha_vec = alpha_extractor.predict(img_batch, verbose=0)[0]
        alpha_per_class[cname] = alpha_vec
        alpha_means.append(float(np.mean(alpha_vec)))
        alpha_stds.append(float(np.std(alpha_vec)))
        print(f"  {cname}: mean_alpha={alpha_means[-1]:.4f} \u00b1 {alpha_stds[-1]:.4f} "
              f"| global={alpha_means[-1]:.2%}  local={(1-alpha_means[-1]):.2%}")

    fig, axes = plt.subplots(1, 2, figsize=(16, 6))
    fig.suptitle("Dual-Path Alpha Blending — Global vs Local Contribution", fontsize=14, fontweight="bold")

    ax = axes[0]
    x = np.arange(num_classes)
    global_vals = alpha_means
    local_vals = [1 - a for a in alpha_means]

    ax.bar(x, global_vals, color="#3498db", alpha=0.88, label="Global Path (Self-Attention)", edgecolor="white")
    ax.bar(x, local_vals, bottom=global_vals, color="#e74c3c", alpha=0.88,
           label="Local Path (Depthwise Conv)", edgecolor="white")

    for i, (g, l, s) in enumerate(zip(global_vals, local_vals, alpha_stds)):
        ax.text(i, g / 2, f"{g:.2%}", ha="center", va="center", fontsize=10, fontweight="bold", color="white")
        ax.text(i, g + l / 2, f"{l:.2%}", ha="center", va="center", fontsize=10, fontweight="bold", color="white")
        ax.errorbar(i, g, yerr=s, fmt="none", color="black", capsize=5, lw=1.5)

    ax.set_xticks(x)
    ax.set_xticklabels(class_names, rotation=15, ha="right")
    ax.set_ylim([0, 1.15])
    ax.set_ylabel("Contribution Ratio (mean \u00b1 std)")
    ax.set_xlabel("Class")
    ax.set_title("Mean Alpha per Class\n(error bar = channel std)", fontsize=12)
    ax.legend(fontsize=10)
    ax.grid(axis="y", alpha=0.3)
    ax.spines[["top", "right"]].set_visible(False)

    ax2 = axes[1]
    data_to_plot = [alpha_per_class[cn] for cn in class_names]
    bp = ax2.boxplot(data_to_plot, patch_artist=True, notch=False, medianprops=dict(color="black", lw=2))
    for patch, color in zip(bp["boxes"], CLASS_COLORS[:num_classes]):
        patch.set_facecolor(color)
        patch.set_alpha(0.75)
    for element in ["whiskers", "caps", "fliers"]:
        for item in bp[element]:
            item.set_color("gray")

    ax2.set_xticklabels(class_names, rotation=15, ha="right")
    ax2.set_ylabel("Alpha Value (per channel)")
    ax2.set_xlabel("Class")
    ax2.set_title("Per-Channel Alpha Distribution\n(box = Q1\u2013Q3, line = median)", fontsize=12)
    ax2.axhline(0.5, color="gray", linestyle="--", lw=1, label="0.5 (equal blend)")
    ax2.legend(fontsize=9)
    ax2.grid(axis="y", alpha=0.3)
    ax2.spines[["top", "right"]].set_visible(False)

    plt.tight_layout()
    save_path = os.path.join(viz_dir, "viz3_alpha_blending.png")
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    print(f"Saved: {save_path}")
    return fig


