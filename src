        ax.bar(x_pos, recall_per, width, label="Recall", color="#2ecc71", edgecolor="white", linewidth=1.2),
        ax.bar(x_pos + width, f1_per, width, label="F1 Score", color="#e74c3c", edgecolor="white", linewidth=1.2),
