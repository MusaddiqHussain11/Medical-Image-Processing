# "CONFUSION MATRIX.txt"
# ---------------------------------------------------------------------
def plot_confusion_matrix(y_test, y_pred, class_names):
    num_classes = len(class_names)
    cm = confusion_matrix(y_test, y_pred)
    cm_norm = cm.astype(float) / cm.sum(axis=1, keepdims=True)

    fig, axes = plt.subplots(1, 2, figsize=(16, 6))
    fig.suptitle("Confusion Matrix", fontsize=16, fontweight="bold")

    for ax_idx, (data, title, fmt) in enumerate([(cm, "Raw Counts", "d"), (cm_norm, "Normalized (%)", ".2f")]):
        ax = axes[ax_idx]
        im = ax.imshow(data, interpolation="nearest", cmap="Blues" if ax_idx == 0 else "RdYlGn")
        plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
        thresh = data.max() / 2.0
        for i in range(num_classes):
            for j in range(num_classes):
                val = f"{data[i,j]:{fmt}}" if fmt == "d" else f"{data[i,j]*100:.1f}%"
                ax.text(j, i, val, ha="center", va="center", fontsize=11, fontweight="bold",
                        color="white" if data[i, j] > thresh else "black")
        ax.set_xticks(range(num_classes))
        ax.set_yticks(range(num_classes))
        ax.set_xticklabels(class_names, rotation=30, ha="right", fontsize=10)
        ax.set_yticklabels(class_names, fontsize=10)
        ax.set_xlabel("Predicted Label", fontsize=12)
        ax.set_ylabel("True Label", fontsize=12)
        ax.set_title(title, fontsize=13, fontweight="bold")

    plt.tight_layout()
    return fig


