# ---------------------------------------------------------------------
# "CLASS ACTIVATION COMPARISON -- PER CLASS.txt"
# Depends on `make_gradcam_heatmap_fixed`, which was referenced but not
# defined in any file of the Zenodo export. Reconstructed here per the
# script's own inline comments ("Absolute gradients — flat heatmap fix",
# "Robust normalization" via 5-95 percentile clip) -- see README for notes.
# ---------------------------------------------------------------------
def make_gradcam_heatmap_fixed(img_array, model, last_conv_layer_name):
    """Reconstructed (see module docstring): same Grad-CAM mechanics as
    make_gradcam_heatmap, but with absolute-value gradient pooling and
    5th/95th percentile-clipped normalization for a less flat heatmap.
    """
    grad_model = tf.keras.models.Model(
        model.inputs, [model.get_layer(last_conv_layer_name).output, model.output]
    )
    with tf.GradientTape() as tape:
        conv_outputs, predictions = grad_model(img_array)
        pred_index = tf.argmax(predictions[0])
        class_channel = predictions[:, pred_index]
    grads = tape.gradient(class_channel, conv_outputs)
    pooled = tf.reduce_mean(tf.abs(grads), axis=(0, 1, 2))
    conv_out = conv_outputs[0]
    heatmap = conv_out @ pooled[..., tf.newaxis]
    heatmap = tf.squeeze(heatmap).numpy()
    p5, p95 = np.percentile(heatmap, 5), np.percentile(heatmap, 95)
    heatmap = np.clip(heatmap, p5, p95)
    heatmap = (heatmap - heatmap.min()) / (heatmap.max() - heatmap.min() + 1e-8)
    return heatmap


def plot_class_activation_comparison(best_model, sample_images, X_test, y_test, class_names,
