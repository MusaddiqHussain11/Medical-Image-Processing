# ---------------------------------------------------------------------
def plot_misclassified_images(X_test, y_test, y_pred, y_pred_proba, class_names, n_show: int = 16):
    misclassified_idx = np.where(y_pred != y_test)[0]
    print(f"\nTotal misclassified: {len(misclassified_idx)} / {len(y_test)}")

    n_show = min(n_show, len(misclassified_idx))
    if n_show == 0:
        print("No misclassified images — nothing to plot.")
        return None

    ncols = 4
    nrows = (n_show + ncols - 1) // ncols
    fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * 3.5, nrows * 3.8))
    fig.suptitle("Misclassified Tympanic Membrane Images", fontsize=15, fontweight="bold")
    axes = np.atleast_2d(axes)

    for idx_show, idx in enumerate(misclassified_idx[:n_show]):
        ax = axes[idx_show // ncols][idx_show % ncols]
        img_mis = X_test[idx]
        true_l = class_names[y_test[idx]]
        pred_l = class_names[y_pred[idx]]
        conf = y_pred_proba[idx][y_pred[idx]]
        ax.imshow(img_mis)
        ax.set_title(f"True: {true_l}\nPred: {pred_l} ({conf:.2f})",
                     fontsize=8.5, fontweight="bold", color="#e74c3c")
        ax.axis("off")
        for spine in ax.spines.values():
            spine.set_edgecolor("#e74c3c")
            spine.set_linewidth(2.5)
            spine.set_visible(True)

    for idx_show in range(n_show, nrows * ncols):
        axes[idx_show // ncols][idx_show % ncols].axis("off")

    plt.tight_layout()
    return fig


