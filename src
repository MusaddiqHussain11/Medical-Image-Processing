    for text in autotexts:
        text.set_fontsize(8)
        text.set_fontweight("bold")
    axes[1].set_title("Parameters by Layer Type", fontsize=12, fontweight="bold")
    plt.tight_layout()
    figs.append(fig1)

    # Fig 2: trainable vs non-trainable, top-10 stacked bar
    df_top = df.sort_values("total", ascending=False).head(10)
    fig2, ax = plt.subplots(figsize=(14, 5))
    fig2.suptitle("Trainable vs Non-Trainable — Top 10 Layers", fontsize=14, fontweight="bold")

