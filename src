# "LOCAL PATH vs GLOBAL PATH COMPARISON.txt"
# ---------------------------------------------------------------------
def plot_local_vs_global_path(ctx, class_names, num_classes: int, img_size: int = 224,
                               asam_add_name: str = None):
    model, class_images, viz_dir = ctx["model"], ctx["class_images"], ctx["VIZ_DIR"]
    depthwise_layers = ctx["depthwise_layers"]

    if not depthwise_layers:
        print("  DepthwiseConv2D layer nahi mili — skip.")
        return None

    local_layer_name = depthwise_layers[0]

    global_layer_name = None
    softmax_idx = None
    for i, layer in enumerate(model.layers):
        if isinstance(layer, layers.Softmax):
            softmax_idx = i
            break
    if softmax_idx is not None:
        for layer in model.layers[softmax_idx + 1:]:
            if isinstance(layer, layers.Conv2D) and len(layer.output.shape) == 4:
                global_layer_name = layer.name
                break

    print(f"  Local  layer: {local_layer_name}")
    print(f"  Global layer: {global_layer_name}")

    try:
        output_layers = [model.get_layer(local_layer_name).output]
        if global_layer_name:
            output_layers.append(model.get_layer(global_layer_name).output)
        dual_extractor = models.Model(inputs=model.input, outputs=output_layers)

        fig, axes = plt.subplots(3, num_classes, figsize=(5 * num_classes, 14))
        fig.suptitle("Local Path (DepthwiseConv) vs Global Path (Self-Attention) — per Class",
                     fontsize=14, fontweight="bold", y=1.01)

        asam_extractor = None
        if asam_add_name:
            asam_extractor = models.Model(inputs=model.input, outputs=model.get_layer(asam_add_name).output)

        for ci, cname in enumerate(class_names):
            img_batch = class_images[cname][np.newaxis, ...]
            orig_img = class_images[cname]
            results = dual_extractor.predict(img_batch, verbose=0)

            local_fm = results[0][0] if isinstance(results, list) else results[0]
            local_map = np.mean(local_fm, axis=-1)
            lmin, lmax = local_map.min(), local_map.max()
            local_norm = (local_map - lmin) / (lmax - lmin + 1e-8)
            local_resized = cv2.resize(local_norm, (img_size, img_size))

            if global_layer_name and isinstance(results, list) and len(results) > 1:
                global_fm = results[1][0]
                global_map = np.mean(global_fm, axis=-1)
                gmin, gmax = global_map.min(), global_map.max()
                global_norm = (global_map - gmin) / (gmax - gmin + 1e-8)
                global_resized = cv2.resize(global_norm, (img_size, img_size))
            elif asam_extractor is not None:
                fb = asam_extractor.predict(img_batch, verbose=0)[0]
                gm = np.mean(fb, axis=-1)
                global_resized = cv2.resize((gm - gm.min()) / (gm.max() - gm.min() + 1e-8), (img_size, img_size))
            else:
                global_resized = np.zeros((img_size, img_size))

            axes[0, ci].imshow(orig_img)
            axes[0, ci].set_title(f"{cname}\nOriginal", fontsize=11, fontweight="bold")
            axes[0, ci].axis("off")

            axes[1, ci].imshow(orig_img)
            im2 = axes[1, ci].imshow(local_resized, cmap="Greens", alpha=0.60, vmin=0, vmax=1)
            axes[1, ci].set_title("Local Path\n(DepthwiseConv)", fontsize=10, color="#27ae60", fontweight="bold")
            axes[1, ci].axis("off")
            plt.colorbar(im2, ax=axes[1, ci], fraction=0.046, pad=0.04)

            axes[2, ci].imshow(orig_img)
            im3 = axes[2, ci].imshow(global_resized, cmap="Blues", alpha=0.60, vmin=0, vmax=1)
            axes[2, ci].set_title("Global Path\n(Self-Attention)", fontsize=10, color="#2980b9", fontweight="bold")
            axes[2, ci].axis("off")
            plt.colorbar(im3, ax=axes[2, ci], fraction=0.046, pad=0.04)

        plt.tight_layout()
        save_path = os.path.join(viz_dir, "viz5_local_vs_global_path.png")
        plt.savefig(save_path, dpi=150, bbox_inches="tight")
        print(f"Saved: {save_path}")
        return fig

    except Exception as e:
        print(f"  Viz 5 error: {e}")
        import traceback
        traceback.print_exc()
        return None

Evaluates a trained 5-fold ensemble on the held-out test set:
  1. F1-weighted ensemble of the 5 fold models.
  2. Test-time augmentation (TTA) applied on top of the best fold model.
  3. Reports whichever of (ensemble, ensemble+TTA) scores higher macro F1;
     that becomes the final reported test result.

Usage:
    python -m src.evaluate --config configs/config.yaml
(Run after src.train has produced fold checkpoints.)
"""

import argparse
import os

import numpy as np
import tensorflow as tf
import yaml
from sklearn.metrics import classification_report, confusion_matrix, f1_score

from .model import CUSTOM_OBJECTS
from .preprocess import preprocess
from .train import load_class_folder, run_cross_validation
from .utils import find_dataset_root


def apply_tta_augmentation(X: np.ndarray, aug_index: int) -> np.ndarray:
    """Deterministic TTA augmentation. Only original (0) and horizontal
    flip (1) are implemented; extend with more augmentations as needed.
    """
    X_aug = X.copy()
    if aug_index == 0:
        pass  # original
    elif aug_index == 1:
        X_aug = X_aug[:, :, ::-1, :]  # horizontal flip
    return X_aug.astype(np.float32)


def evaluate_ensemble_and_tta(cfg: dict, cv_result: dict):
    dataset_root = find_dataset_root(cfg["paths"]["input_root"])
    test_dir = os.path.join(dataset_root, "Testing")
    class_names = cv_result["class_names"]
    img_size = cfg["img_size"]

    X_test, y_test = load_class_folder(test_dir, class_names, img_size)
    print(f"\nTest images: {len(X_test)}")

    fold_ckpts = cv_result["fold_ckpts"]
    cv_f1 = cv_result["cv_f1"]
    best_ckpt = cv_result["best_ckpt"]

    # --- Ensemble (F1-weighted average of fold predictions) ---
    all_preds = []
    for ckpt_path in fold_ckpts:
        fold_model = tf.keras.models.load_model(ckpt_path, custom_objects=CUSTOM_OBJECTS)
        all_preds.append(fold_model.predict(X_test, verbose=0))

    fold_weights = np.array(cv_f1) / np.sum(cv_f1)
    ensemble_preds = np.average(all_preds, axis=0, weights=fold_weights)
    ensemble_classes = np.argmax(ensemble_preds, axis=1)

    ensemble_acc = np.mean(ensemble_classes == y_test)
    ensemble_f1 = f1_score(y_test, ensemble_classes, average="macro")
    print(f"\nEnsemble Accuracy: {ensemble_acc:.4f} ({ensemble_acc*100:.2f}%)")
    print(f"Ensemble Macro F1: {ensemble_f1:.4f}")
    print(classification_report(y_test, ensemble_classes, target_names=class_names))
    print(confusion_matrix(y_test, ensemble_classes))

    # --- TTA on top of the best fold model ---
    tta_augments = cfg.get("tta", {}).get("augments", 8)
    tta_model = tf.keras.models.load_model(best_ckpt, custom_objects=CUSTOM_OBJECTS)

    aug_preds = []
    for i in range(tta_augments):
        X_aug = apply_tta_augmentation(X_test, aug_index=i)
        aug_preds.append(tta_model.predict(X_aug, verbose=0))

    tta_preds = np.mean(aug_preds, axis=0)
    tta_classes = np.argmax(tta_preds, axis=1)
    tta_acc = np.mean(tta_classes == y_test)
    tta_f1 = f1_score(y_test, tta_classes, average="macro")
    print(f"\nTTA Accuracy: {tta_acc:.4f} ({tta_acc*100:.2f}%)")
    print(f"TTA Macro F1: {tta_f1:.4f}")
    print(classification_report(y_test, tta_classes, target_names=class_names))
    print(confusion_matrix(y_test, tta_classes))

    use_tta = tta_f1 > ensemble_f1
    print("\nUsing TTA predictions." if use_tta else "\nUsing ensemble predictions.")

    y_pred = tta_classes if use_tta else ensemble_classes
    y_pred_proba = tta_preds if use_tta else ensemble_preds

    return {
        "X_test": X_test,
        "y_test": y_test,
        "y_pred": y_pred,
        "y_pred_proba": y_pred_proba,
        "ensemble_acc": ensemble_acc,
        "ensemble_f1": ensemble_f1,
        "tta_acc": tta_acc,
        "tta_f1": tta_f1,
        "use_tta": use_tta,
    }


