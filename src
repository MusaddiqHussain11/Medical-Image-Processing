def get_asam_blended_map(model, img_array):
    try:
        target = model.get_layer("asam_global_attn")
    except ValueError:
        try:
            target = model.get_layer("asam_blended_output")
            print("  \u26a0\ufe0f  asam_global_attn nahi mili, asam_blended_output use ho rahi hai")
        except ValueError:
            target = None
            for l in model.layers:
                if isinstance(l, tf.keras.layers.Activation):
                    target = l
                    break
    if target is None:
        print("  \u26a0\ufe0f  ASAM layer nahi mili!")
        return None

    feat_model = tf.keras.Model(inputs=model.input, outputs=target.output)
    features = feat_model(img_array, training=False)
    feat_np = features.numpy()[0]
    spatial = feat_np.mean(axis=-1)
    spatial = np.maximum(spatial, 0)
    spatial = spatial - spatial.min()
    if spatial.max() > 1e-8:
        spatial = spatial / spatial.max()
    return spatial.astype(np.float32)


def get_grad_cam_v4(model, img_array, class_idx):
    try:
        target_layer = model.get_layer("asam_global_attn")
    except ValueError:
        target_layer = None
        for layer in reversed(model.layers):
            if isinstance(layer, tf.keras.layers.Conv2D):
                target_layer = layer
                break
    if target_layer is None:
        return None

    grad_model = tf.keras.Model(inputs=model.input, outputs=[target_layer.output, model.output])
    with tf.GradientTape() as tape:
        conv_out, preds = grad_model(img_array, training=False)
        loss = preds[:, class_idx]
    grads = tape.gradient(loss, conv_out)
    pooled = tf.reduce_mean(grads, axis=(0, 1, 2))
    cam = tf.reduce_sum(conv_out[0] * pooled[tf.newaxis, tf.newaxis, :], axis=-1).numpy()
    cam = np.maximum(cam, 0)
    cam = cam - cam.min()
    if cam.max() > 1e-8:
        cam = cam / cam.max()
    return cam.astype(np.float32)


def _resize_to_224(heatmap, h=224, w=224):
    r = cv2.resize(heatmap, (w, h), interpolation=cv2.INTER_LINEAR)
    r = r - r.min()
    if r.max() > 1e-8:
        r = r / r.max()
    return r.astype(np.float32)


def _make_overlay_v4(img, heatmap, cmap=cv2.COLORMAP_JET, alpha=0.50):
    h, w = img.shape[:2]
    hm = cv2.resize(heatmap, (w, h))
    hm_color = cv2.applyColorMap(np.uint8(255 * hm), cmap)
    hm_color = cv2.cvtColor(hm_color, cv2.COLOR_BGR2RGB).astype(np.float32) / 255.0
    overlay = alpha * hm_color + (1 - alpha) * img.astype(np.float32)
    return np.clip(overlay, 0, 1)


def _agreement_v4(a, b):
    ag = np.sqrt(np.maximum(a, 0) * np.maximum(b, 0) + 1e-8)
    ag = ag - ag.min()
    if ag.max() > 1e-8:
        ag = ag / ag.max()
    return ag.astype(np.float32)


def _correlations_v4(a, b):
    p = float(np.corrcoef(a.flatten(), b.flatten())[0, 1])
    s = float(spearmanr(a.flatten(), b.flatten()).statistic)
    return p, s


def plot_asam_vs_gradcam_agreement(best_model, X_test, y_test, y_pred, class_names):
    class_sample_imgs, class_sample_labels = {}, {}
    print("\n  Selecting best-agreement image per class...")

    for cls_idx, cls_name in enumerate(class_names):
        correct = np.where((y_test == cls_idx) & (y_pred == cls_idx))[0]
        candidates = correct if len(correct) > 0 else np.where(y_test == cls_idx)[0]
        candidates = candidates[:20]

        best_idx, best_corr = candidates[0], -999.0
        for idx in candidates:
            img_in = np.expand_dims(X_test[idx], axis=0)
            asam_raw = get_asam_blended_map(best_model, img_in)
            gradcam_raw = get_grad_cam_v4(best_model, img_in, cls_idx)
            if asam_raw is None or gradcam_raw is None:
                continue
            asam_224 = _resize_to_224(asam_raw)
            gradcam_224 = _resize_to_224(gradcam_raw)
            p, s = _correlations_v4(asam_224, gradcam_224)
            avg = (p + s) / 2.0
            if avg > best_corr:
                best_corr, best_idx = avg, idx

        class_sample_imgs[cls_name] = X_test[best_idx]
        class_sample_labels[cls_name] = cls_idx
        print(f"    {cls_name:<25} best r+\u03c1 avg = {best_corr:+.4f}  (idx={best_idx})")

    n_classes = len(class_names)
    col_titles = ["Original Image", "ASAM Global Attention\n(HOT colormap)", "Grad-CAM\n(JET colormap)",
                  "Agreement Map\n(Geometric Mean)", "Activation Profile\n(Top \u2192 Bottom)"]

    fig = plt.figure(figsize=(28, n_classes * 6.5))
    fig.suptitle("ASAM Global Attention vs Grad-CAM — Same Image Comparison\n"
                 "(Best-agreement correctly classified image shown per class)",
                 fontsize=16, fontweight="bold", y=0.98)
    gs = gridspec.GridSpec(n_classes, 5, figure=fig, hspace=0.35, wspace=0.08,
                            left=0.06, right=0.99, top=0.93, bottom=0.02)

    summary_results = []

    for row_idx, cls_name in enumerate(class_names):
        img = class_sample_imgs[cls_name]
        cls_idx = class_sample_labels[cls_name]
        img_in = np.expand_dims(img, axis=0)

        asam_raw = get_asam_blended_map(best_model, img_in)
        gradcam_raw = get_grad_cam_v4(best_model, img_in, cls_idx)
        asam_224 = _resize_to_224(asam_raw)
        gradcam_224 = _resize_to_224(gradcam_raw)
        agree_224 = _agreement_v4(asam_224, gradcam_224)

        asam_ov = _make_overlay_v4(img, asam_224, cv2.COLORMAP_HOT, 0.50)
        gradcam_ov = _make_overlay_v4(img, gradcam_224, cv2.COLORMAP_JET, 0.50)
        agree_ov = _make_overlay_v4(img, agree_224, cv2.COLORMAP_PLASMA, 0.55)

        pearson, spearman = _correlations_v4(asam_224, gradcam_224)
        summary_results.append((cls_name, pearson, spearman))

        py_a, px_a = np.unravel_index(np.argmax(asam_224), asam_224.shape)
        py_g, px_g = np.unravel_index(np.argmax(gradcam_224), gradcam_224.shape)
        delta_peak = np.sqrt((px_a - px_g) ** 2 + (py_a - py_g) ** 2)

        ax0 = fig.add_subplot(gs[row_idx, 0])
        ax0.imshow(img)
        ax0.set_ylabel(cls_name, fontsize=10, fontweight="bold", labelpad=8)
        ax0.set_title(col_titles[0] if row_idx == 0 else "", fontsize=11, fontweight="bold")
        ax0.axis("off")

        ax1 = fig.add_subplot(gs[row_idx, 1])
        ax1.imshow(asam_ov)
        ax1.plot(px_a, py_a, "w*", ms=13, mec="black", mew=0.8)
        ax1.set_title(col_titles[1] if row_idx == 0 else "", fontsize=11, fontweight="bold")
        ax1.axis("off")

        ax2 = fig.add_subplot(gs[row_idx, 2])
        ax2.imshow(gradcam_ov)
        ax2.plot(px_g, py_g, "w*", ms=13, mec="black", mew=0.8)
        ax2.text(0.97, 0.03, f"\u0394peak={delta_peak:.0f}px", transform=ax2.transAxes, ha="right", va="bottom",
                 fontsize=8, color="white", bbox=dict(boxstyle="round,pad=0.25", fc="#c0392b", alpha=0.85))
        ax2.set_title(col_titles[2] if row_idx == 0 else "", fontsize=11, fontweight="bold")
        ax2.axis("off")

        ax3 = fig.add_subplot(gs[row_idx, 3])
        ax3.imshow(agree_ov)
        badge_color = "#27ae60" if pearson >= 0.55 else "#e67e22" if pearson >= 0.30 else "#c0392b"
        ax3.text(0.97, 0.97, f"r  = {pearson:+.3f}\n\u03c1  = {spearman:+.3f}", transform=ax3.transAxes,
                 ha="right", va="top", fontsize=9, fontweight="bold", color="white",
                 bbox=dict(boxstyle="round,pad=0.35", fc=badge_color, alpha=0.90))
        ax3.set_title(col_titles[3] if row_idx == 0 else "", fontsize=11, fontweight="bold")
        ax3.axis("off")

        ax4 = fig.add_subplot(gs[row_idx, 4])
        asam_prof = asam_224.mean(axis=1)
        gradcam_prof = gradcam_224.mean(axis=1)
        y_ax = np.linspace(0, 1, 224)
        ax4.plot(asam_prof, y_ax, color="#e74c3c", lw=2.2, label="ASAM", alpha=0.90)
